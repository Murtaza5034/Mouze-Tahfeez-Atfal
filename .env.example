# =============================================================================
# MAUZE TAHFEEZ - ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Firebase Configuration (Web Client & Admin)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# -----------------------------------------------------------------------------
# 2. Supabase / PostgreSQL Configuration (Database & Authentication)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your_supabase_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# 3. WhatsApp Cloud API (Meta Graph API)
# -----------------------------------------------------------------------------
# Token generated from Meta Developer App (Permanent system user token)
WHATSAPP_TOKEN=EAAG...your_meta_system_user_token
# Phone Number ID found under WhatsApp > API Setup in Meta Developer Dashboard
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Custom secret token for webhook verification (set same in Meta Webhook config)
WHATSAPP_VERIFY_TOKEN=mauze_tahfeez_verify_token

# -----------------------------------------------------------------------------
# 4. Twilio WhatsApp API (Alternative WhatsApp Provider)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# -----------------------------------------------------------------------------
# 5. Public URLs & App Deployment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PORTAL_URL=https://mauze-tahfeez.vercel.app/
FCM_SERVER_KEY=your_fcm_server_key
